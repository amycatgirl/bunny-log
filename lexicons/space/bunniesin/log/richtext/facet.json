{
  "lexicon": 1,
  "id": "space.bunniesin.log.richtext.facet",
  "description": "Rich text facets used to add flare to entries.",
  "defs": {
    "bold": {
      "type": "object",
      "description": "Facet feature for emphasised text."
    },
    "italic": {
      "type": "object",
      "description": "Facet feature for italicised text."
    },
    "colour": {
      "type": "object",
      "description": "Facet feature for coloured text. Colours must not be hexadecimal values, only canonical colour names. Available colours may change over time.",
      "properties": {
        "colour": {
          "type": "string",
          "enum": [
             "red",
             "green",
             "blue",
             "pink",
             "yellow",
             "orange",
             "purple",
             "cyan",
             "aqua"
          ]
        }
      }
    },
    "code": {
      "type": "object",
      "description": "Facet feature for monospaced text, usually for displaying inline snippets of code."
    },
    "link": {
      "type": "object",
      "description": "Facet feature for a URL.",
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "highlight": {
      "type": "object",
      "description": "Facet feature for a highlighted region of text.",
      "properties": {
        "colour": {
          "type": "string",
          "enum": [
            "yellow",
            "green",
            "pink",
            "cyan"
          ],
          "default": "yellow"
        }
      }
    }
  }
}
